# Backend
DATABASE_URL="postgresql://miniledger:miniledger@localhost:5432/miniledger?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-another-long-random-value
JWT_EXPIRES_IN=7d
APP_TIME_ZONE=Asia/Kolkata
MOBILE_ORIGIN=*

# Expo embeds EXPO_PUBLIC_ values in the client bundle. Never put secrets here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api

