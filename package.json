{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @miniledger/backend",
    "dev:mobile": "npm run start --workspace @miniledger/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @miniledger/backend",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @miniledger/backend",
    "db:migrate": "npm run db:migrate --workspace @miniledger/backend",
    "db:seed": "npm run db:seed --workspace @miniledger/backend"
  },
  "engines": {
    "node": ">=20"
  }
}

