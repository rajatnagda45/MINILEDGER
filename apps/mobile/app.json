{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "miniledger",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniLedger uses your photos so you can attach a receipt image to a loan.",
          "cameraPermission": "MiniLedger uses your camera so you can photograph a receipt for a loan."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rajatnagda.miniledger"
    },
    "android": {
      "package": "com.rajatnagda.miniledger",
      "adaptiveIcon": {
        "backgroundColor": "#F4F6FA"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

